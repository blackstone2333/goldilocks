{
  "description": "Goldilocks continuity recovery plus subagent routing enforcement and audit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/agent_routing_guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\agent_routing_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking Goldilocks agent routing"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/agent_routing_guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\agent_routing_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/agent_routing_guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\agent_routing_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/recovery_reminder.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\recovery_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking Goldilocks continuity"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/recovery_reminder.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\recovery_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking Goldilocks recovery state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/recovery_reminder.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\recovery_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
