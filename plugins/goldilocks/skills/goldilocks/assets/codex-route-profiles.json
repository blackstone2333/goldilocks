      "work_type": "spark-coding",
      "capabilities": "project",
      "sandbox": "workspace-write",
      "may_delegate": false
    },
    "goldilocks_spark_worker": {
      "tier": "fast",
      "model": "gpt-5.3-codex-spark",
      "reasoning_effort": "xhigh",
      "transport": "native",
      "agent_type": "goldilocks_spark_worker",
      "may_delegate": false
    },
    "goldilocks_luna_worker": {
      "tier": "fast",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "max",
